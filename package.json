{
  "name": "private-board",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "ops:integrity": "node --env-file=.env.local scripts/ops.mjs integrity",
    "ops:cleanup": "node --env-file=.env.local scripts/ops.mjs cleanup",
    "test:database": "node --env-file=.env.local --test tests/database.integration.test.ts",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}

