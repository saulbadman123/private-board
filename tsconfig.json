{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "server", "shared", "api", "tests", "vite.config.ts"]
}
