# Server only. Never prefix these values with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
APP_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional capacity switch. Set to 1 to keep reads/unlocks working while board
# creation and posting return a clear "paused" message. Redeploy to apply.
# WRITES_DISABLED=0

# Optional. Only used by live integration tests, never by the browser.
# TEST_SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PROJECT_PUBLISHABLE_KEY
